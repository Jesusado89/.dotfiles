{
  "layer": "top",
  "position": "top",
  "height": 40,
  "modules-left": [
    "ext/workspaces"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "tray",
    "custom/updates",
    "custom/vpn",
    "idle_inhibitor",
    "cpu",
    "memory",
    "temperature",
    "backlight",
    "pulseaudio",
    "network#wifi",
    "network#eth",
    "bluetooth",
    "battery",
    "power-profiles-daemon",
    "clock"
  ],
  "ext/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-id": true,
    "ignore-hidden": true
  },
  "clock": {
    "format": "󰥔 {:%I:%M%p}",
    "format-alt": "󰃭 {:%d/%m/%Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "gnome-calendar"
  },
  "pulseaudio": {
    "format": "{icon} {volume}",
    "format-muted": "󰝟",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "~/.config/waybar/scripts/volume-menu.sh",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "{desc} · {volume}"
  },
  "backlight": {
    "format": "{icon} {percent}",
    "format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip-format": "Brillo · {percent}"
  },
  "network#wifi": {
    "interface": "wlp2s0",
    "format-wifi": "  {essid}",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ifname} via {gwaddr}",
    "on-click": "nm-connection-editor"
  },
  "network#eth": {
    "interface": "enp3s0",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "",
    "tooltip-format-ethernet": "{ifname} via {gwaddr}",
    "on-click": "nm-connection-editor"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "󰗑",
      "performance": "󱐋",
      "balanced": "󰗑",
      "power-saver": "󰌪"
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": " {num_connections}",
    "tooltip-format": "{device_alias}",
    "tooltip-format-connected": "<b>{device_alias}</b>\n{device_address}",
    "tooltip-format-enumerate-connected": "<b>{device_alias}</b>\n{device_address}",
    "on-click": "blueman-manager"
  },
  "battery": {
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-alt": "{icon} {capacity}",
    "format-charging": "󰂄",
    "format-charging-alt": "󰂄 {capacity}",
    "format-plugged": "󰚥",
    "format-plugged-alt": "󰚥 {capacity}",
    "format-full": "󰂅",
    "format-full-alt": "󰂅 {capacity}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo} · {capacity}%"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰌾",
      "deactivated": "󰌿"
    },
    "tooltip": true,
    "tooltip-format-activated": "Inhibidor activo",
    "tooltip-format-deactivated": "Inhibidor inactivo"
  },
  "mpris": {
    "format": "󰐊 {title} - {artist}",
    "format-paused": "󰏤 {title} - {artist}",
    "format-stopped": "󰓦 Detenido",
    "player-icons": {
      "default": "󰋾",
      "youtube-music-bin": "󰗃"
    },
    "status-icons": {
      "playing": "󰐊",
      "paused": "󰏤"
    },
    "tooltip-format": "{player_name}\n{title}\n{artist} · {album}",
    "max-length": 45,
    "truncation-symbol": "…",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next"
  },
  "cpu": {
    "interval": 3,
    "format": "󰻠 {usage}%",
    "tooltip": true,
    "tooltip-format": "CPU: {usage}%\nFreq: {avg_frequency}GHz"
  },
  "memory": {
    "interval": 5,
    "format": "󰍛 {}%",
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G"
  },
  "temperature": {
    "interval": 4,
    "thermal-zone": 9,
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°",
    "format-critical": "{icon} {temperatureC}°",
    "format-icons": ["󰜗", "󱃃", "󰔏", "󱃂", "󰸁"],
    "tooltip": true,
    "tooltip-format": "CPU package: {temperatureC}°C"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8,
    "show-passive-items": false,
    "ignored-items": ["blueman", "blueman-tray", "blueman-applet"]
  },
  "custom/updates": {
    "format": "󰮯 {}",
    "interval": 1800,
    "exec": "~/.config/waybar/scripts/check-updates.sh",
    "on-click": "kitty -e bash -c 'paru -Syu && pkill -RTMIN+8 waybar'",
    "signal": 8,
    "tooltip": true,
    "return-type": "json"
  },
  "custom/vpn": {
    "format": "{}",
    "interval": 30,
    "exec": "~/.config/waybar/scripts/vpn-status.sh",
    "return-type": "json",
    "tooltip": true
  }
}
