# mako config — regenerado por theme-switch.sh al cambiar tema.
# Paleta: hackerman

font=FiraCode Nerd Font 11
default-timeout=5000
background-color=#191a23eb
text-color=#ddf7ff
border-color=#6a6e95
border-size=1
border-radius=8
padding=12
margin=10
max-icon-size=48
sort=-time
layer=overlay
anchor=top-right
width=380
height=140

[urgency=low]
border-color=#6a6e95
default-timeout=3000

[urgency=normal]
border-color=#6a6e95

[urgency=high]
border-color=#50f872
default-timeout=0

[mode=do-not-disturb]
invisible=1
