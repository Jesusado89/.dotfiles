# mako config — regenerado por theme-switch.sh al cambiar tema.
# Paleta: catppuccin-mocha

font=FiraCode Nerd Font 11
default-timeout=5000
background-color=#181825eb
text-color=#cdd6f4
border-color=#585b70
border-size=1
border-radius=8
padding=12
margin=10
max-icon-size=48
sort=-time
layer=overlay
anchor=top-right
width=380
height=140

[urgency=low]
border-color=#585b70
default-timeout=3000

[urgency=normal]
border-color=#585b70

[urgency=high]
border-color=#f38ba8
default-timeout=0

[mode=do-not-disturb]
invisible=1
