# mako config — regenerado por theme-switch.sh al cambiar tema.
# Paleta: osaka-jade

font=FiraCode Nerd Font 11
default-timeout=5000
background-color=#1f2925eb
text-color=#C1C497
border-color=#53685b
border-size=1
border-radius=8
padding=12
margin=10
max-icon-size=48
sort=-time
layer=overlay
anchor=top-right
width=380
height=140

[urgency=low]
border-color=#53685b
default-timeout=3000

[urgency=normal]
border-color=#53685b

[urgency=high]
border-color=#FF5345
default-timeout=0

[mode=do-not-disturb]
invisible=1
